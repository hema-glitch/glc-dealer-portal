# Copy these EXACT variable names into Vercel → Project Settings → Environment Variables

ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here
ZOHO_ORG_ID=your_org_id_here

ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_BOOKS_URL=https://www.zohoapis.com/books/v3
ZOHO_INVENTORY_URL=https://www.zohoapis.com/inventory/v1

# Your Vercel deployment URL (set AFTER first deploy)
# e.g. https://glc-dealer-portal.vercel.app
APP_URL=https://your-app.vercel.app

JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=8h

ADMIN_EMAIL=admin@glcpaints.com
ADMIN_PASSWORD=Admin@1234

# Shared cache for Vercel serverless instances (recommended)
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
CACHE_NAMESPACE=glc-dealer-portal-production

# Zoho Flow/Books/Inventory webhook secret for cache invalidation
ZOHO_WEBHOOK_SECRET=replace_with_a_random_webhook_secret

# Cache TTL fallback if webhooks are not configured yet
CACHE_TTL_DEALER_MS=21600000
CACHE_TTL_DEALERS_MS=21600000
CACHE_TTL_FINANCIAL_MS=21600000
CACHE_TTL_PRODUCTS_MS=21600000
CACHE_TTL_ORDERS_MS=1800000
